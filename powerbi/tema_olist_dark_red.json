{
  "name": "Olist Dark Red",
  "dataColors": ["#E5383B", "#FF7B7B", "#A4161A", "#8D99AE", "#D9D9D9", "#F4A261", "#6C757D", "#660708"],
  "background": "#121214",
  "foreground": "#F5F5F5",
