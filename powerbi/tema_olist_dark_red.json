  "good": "#2EC4B6",
  "neutral": "#F4A261",
  "bad": "#E5383B",
  "maximum": "#E5383B",
  "center": "#8D99AE",
  "minimum": "#3A3A42",
  "null": "#6C757D",
  "firstLevelElements": "#F5F5F5",
  "secondLevelElements": "#B8B8C0",
  "thirdLevelElements": "#2A2A30",
  "fourthLevelElements": "#6C757D",
  "secondaryBackground": "#1C1C20",
  "tertiaryBackground": "#2A2A30",
  "hyperlink": "#FF7B7B",
