  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1C1C20" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2A2A30" } }, "radius": 8 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#F5F5F5" } }, "fontSize": 12, "alignment": "left" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#121214" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#0B0B0C" } }, "transparency": 0 }]
      }
    }
  }
